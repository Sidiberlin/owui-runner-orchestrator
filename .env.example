# =============================================================================
#  OWUI Agent Runner Orchestrator — configuration
#  cp .env.example .env  and fill in the four required secrets.
# =============================================================================

# --- REQUIRED SECRETS --------------------------------------------------------
# Three DISTINCT values. Never reuse one for another (v1.1 hardening).
#   generate with:  openssl rand -hex 32
#
# K1 — the Bearer key OWUI's admin Open Terminal connection sends to us.
ORCH_API_KEY=CHANGEME-openssl-rand-hex-32
# Seed for per-runner Open Terminal key derivation (N1).
#   key = HMAC-SHA256(ORCH_MASTER_SECRET, uid + ":" + container_id)
# Rotating this invalidates every live runner's key; reconciliation must
# re-derive, so rotate during a quiet window.
ORCH_MASTER_SECRET=CHANGEME-openssl-rand-hex-32
# OWUI admin API, for X-User-Id -> role resolution (Q1).
OWUI_BASE_URL=http://192.168.x.101:8080
OWUI_ADMIN_TOKEN=CHANGEME-owui-admin-api-token

# --- orchestrator bind --------------------------------------------------------
# This is the URL you put in OWUI: Admin Settings > Integrations > Open Terminal.
ORCH_PORT=8080
# Tighten to the LAN-facing address if you do not want it on every interface.
ORCH_BIND=0.0.0.0
ORCH_TAG=dev

# --- role mapper (A8: fail closed) -------------------------------------------
ROLE_CACHE_TTL=60          # seconds a resolved role is fresh
ROLE_CACHE_GRACE=600       # serve stale roles this long if OWUI is unreachable,
                           # then 503. Never fail open.
OWUI_API_TIMEOUT=5         # hard timeout on the admin API call

# --- runner lifecycle ---------------------------------------------------------
RUNNER_IMAGE=owui-agent-runner:dev
RUNNERS_NETWORK=owui-runners-internal

RUNNER_CPUS=1.5
# N13: sized to the MEASURED host envelope (7.6 GiB total, 0.6-2.1 GiB available
# under load), not to MemTotal. 3 x 768m = 2.25 GiB peak + MEMORY_RESERVE.
# The briefed 6 x 1g did not fit and every spawn was refused with a 429.
RUNNER_MEMORY=768m
RUNNER_PIDS=256
MAX_CONTAINERS=3
IDLE_TIMEOUT=30m           # idle = no request AND no running process (C7)

# Runner security posture.
# N5: this host is an LXC container and cannot load AppArmor profiles. On a
#     host where docker-default loads, drop `apparmor=unconfined`.
# N8: the runner entrypoint starts as root, chowns $HOME (this is what fixes a
#     fresh root-owned volume), then gosu-drops to uid 1000. Removing SETUID/
#     SETGID/CHOWN breaks the drop and the ownership fix. Do not trim this list
#     without re-running the Lane A persistence test.
RUNNER_SECURITY_OPT=no-new-privileges,apparmor=unconfined
RUNNER_CAP_ADD=CHOWN,DAC_OVERRIDE,FOWNER,SETUID,SETGID

# --- disk (N4) ----------------------------------------------------------------
# This host has no loop devices (LXC) and no project quotas (ext4, no prjquota),
# so Q6=A was not implementable. This is monitor-and-enforce: detection, not
# prevention. A fast writer can outrun the poll. See v1.2 N4 for upgrade paths.
RUNNER_DISK_SOFT=5g            # refuse new spawns for a user above this
RUNNER_DISK_HARD=6g            # stop a running container above this
WORKSPACE_TOTAL_CEILING=60g    # aggregate across all volumes (R2). Enforced at
                               # admission: once the known total reaches this,
                               # new spawns get a clean 429 instead of filling
                               # the host.

# R2 retention. 0 = NEVER DELETE (the default, deliberately: this destroys a
# user's workspace). Set to e.g. 90 to reclaim volumes for people who have not
# used a runner in 90 days. The sweep never touches a live runner, never acts
# outside this orchestrator's RUNNERS_NETWORK, and skips any uid it has no
# activity record for (it starts that uid's clock instead), so a fresh state
# file cannot delete on first sight.
VOLUME_RETENTION_DAYS=0
RETENTION_SWEEP_INTERVAL=3600
DISK_POLL_INTERVAL=60          # seconds; lower = smaller race window, more load
IDLE_SWEEP_INTERVAL=30         # how often idle runners are checked; worst-case
                               # teardown latency is IDLE_TIMEOUT + this

# --- per-role policy (Lane C) -------------------------------------------------
# Roles come from OWUI: pending -> 403, user -> normal, admin -> these limits.
# Leave blank to give admins exactly the same limits as users (the safe
# default: admin runners still count against MAX_CONTAINERS either way).
# OWUI also returns each user's `groups`, which is where v2 group permissions
# plug in — see Policy in app/roles.py, the single injection point.
ADMIN_RUNNER_CPUS=
ADMIN_RUNNER_MEMORY=
ADMIN_RUNNER_DISK_SOFT=

# --- Policy profiles (v2, ADR-0012) -------------------------------------------
# Tune settings PER GROUP without touching global env or redeploying. See
# "## Policy profiles" in README.md for the full picture (first-match
# priority, default-equals-today, the group-rename caveat, a worked example
# with its boot-log output); this is deliberately just the convention.
#
# A Policy profile is a named bundle of exactly six settings — cpus, memory,
# idle timeout, exec timeout, image, egress stance — declared as
# POLICY_<NAME>_<FIELD> vars. Every field you leave unset inherits the
# matching global knob above, so a profile only ever states what makes it
# different. "<NAME>" is yours to choose (matched case-insensitively
# against GROUP_MAP below); "default" is reserved (it is always exactly
# today's globals — declaring POLICY_DEFAULT_* is a startup error).
#
# GROUP_MAP is an ordered, comma-separated groupname:profile list. At
# request time, the caller's OWUI groups are checked against it LEFT TO
# RIGHT — the first entry whose group they belong to wins. No group, an
# unmapped group, or a group GROUP_MAP names that no longer matches any of
# the caller's groups (e.g. renamed in OWUI) all fall back to the default
# profile — this can never deny a request, only tune it; the role check and
# the allowlist above still own access. Leave both blank (the default) and
# the fleet behaves byte-for-byte as if this whole section did not exist.
#
# Example (commented out — uncomment and adjust to actually enable):
#   POLICY_HEAVY_CPUS=4
#   POLICY_HEAVY_MEMORY=4g
#   GROUP_MAP=data-science:heavy
GROUP_MAP=

# Q5 denylist: everything NOT listed here is forwarded to the runner verbatim.
# This is deliberately a denylist, not an allowlist — an allowlist silently
# 404s any sidebar endpoint nobody predicted, and the original one also dropped
# the /execute kill switch, stdin, and the process list the idle rule needs.
PROXY_DENY_PREFIXES=/proxy,/ports,/api/terminals

# CSP injected on /files/serve responses. VERIFIED LIVE: without it, HTML an
# agent writes into its workspace is returned as text/html from OWUI's own
# origin with no security headers, which is a stored-XSS path to the OWUI
# session. "sandbox" puts it in an opaque origin so scripts cannot run.
# Empty disables the hardening (previews with JS would then work, unsafely).
FILES_SERVE_CSP=sandbox

# --- Open Terminal containment, pushed into each runner (C6) ------------------
OPEN_TERMINAL_MAX_SESSIONS=8
OPEN_TERMINAL_EXECUTE_TIMEOUT=120
OPEN_TERMINAL_SESSION_CWD_TTL=604800
# NOTE: OPEN_TERMINAL_ALLOWED_DOMAINS is deliberately absent (N9). Setting it —
# even to "" — activates the runner entrypoint's iptables/dnsmasq firewall,
# which needs CAP_NET_ADMIN we do not grant. `internal: true` is stronger.

# --- plumbing -----------------------------------------------------------------
# Memory left free on the host after admitting a runner (R3). On a 7.6 GiB box
# running other services, MAX_CONTAINERS x RUNNER_MEMORY + this must fit in
# what is actually available, not in MemTotal. Measured on this host: ~2 GiB
# available under normal load, so the 6 x 1g default above is optimistic.
MEMORY_RESERVE=512m
# Free-memory admission gate, OFF by default. Measured on this host: the
# orchestrator container's /proc/meminfo reports 534 MiB available while the
# host has 1908 MiB, because /proc is virtualised inside Docker-on-LXC. A gate
# built on that refuses users for no reason. MAX_CONTAINERS x RUNNER_MEMORY is
# the deterministic bound; turn this on only on a full VM.
MEMORY_GATE=off
# Optional hard ceiling on total committed runner memory. Blank = bounded by
# MAX_CONTAINERS x RUNNER_MEMORY alone.
RUNNER_MEMORY_BUDGET=
# Bump to make every existing runner reapable on the next reconciliation.
# This is how you roll out a new runner image without orphaning containers.
RUNNER_VERSION=1
# Daemon reports MinAPIVersion 1.44; aiodocker's default is older and is
# rejected outright. Only change this if the daemon changes.
DOCKER_API_VERSION=v1.44
LOG_LEVEL=INFO

# --- Package Seam (ADR-0008) --------------------------------------------------
# Injected into every runner at CREATE time. Empty = no index override.
#
# Runners have zero egress by design, so pip/npm cannot reach PyPI/npmjs
# directly. Set DEVGUARD_ENABLED=true and PIP_INDEX_URL/PIP_TRUSTED_HOST/
# NPM_CONFIG_REGISTRY all derive (pip via the shim, ADR-0010; npm straight
# to DevGuard) — that keeps installs working without ever opening an egress
# hole, because the proxy is reachable inside the isolated network, not
# because the network was loosened. An explicit value below ALWAYS wins over
# the derived one, so you can point at something else entirely.
DEVGUARD_ENABLED=false
DEVGUARD_BASE_URL=http://devguard-api:8080
# pip alone routes via the shim (ADR-0010); npm goes straight to DevGuard.
PIP_SHIM_BASE_URL=http://pip-shim:8080
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
NPM_CONFIG_REGISTRY=

# --- DevGuard platform (ADR-0007, `docker compose --profile devguard up -d`) --
# Upstream ships no production compose (theirs is dev-only: postgres+kratos+
# jaeger). These services are synthesised from the helm chart at v1.14.0.
DEVGUARD_VERSION=v1.14.0
DEVGUARD_DB_PASSWORD=CHANGEME-openssl-rand-hex-32
# Dependency-proxy cache. Chart default is 4096 MB; 2048 chosen for this host.
DEVGUARD_PROXY_CACHE_MB=2048
# Memory caps. Sized against the 10 GiB host alongside OWUI (1g) and
# 3 x 1g runners; see the README budget table.
DEVGUARD_API_MEMORY=2048m
DEVGUARD_API_GOMEMLIMIT=1024MiB
DEVGUARD_PG_MEMORY=512m
DEVGUARD_KRATOS_MEMORY=256m
DEVGUARD_WEB_MEMORY=256m
DEVGUARD_KRATOS_LOG_LEVEL=warning
DEVGUARD_ENVIRONMENT=prod
# The web UI publishes no ports by operator decision (internal-only).
DEVGUARD_API_URL=http://devguard-api:8080
DEVGUARD_FRONTEND_URL=http://devguard-web:3000
DEVGUARD_INSTANCE_DOMAIN=http://devguard-api:8080

# Open WebUI's existing docker network, which the orchestrator joins so OWUI
# can reach it by name once consolidated on one host (ADR-0006).
OWUI_NETWORK=open-webui_default
