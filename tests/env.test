# Test-only configuration. These secrets are fake by design and only ever
# reach a throwaway stack on a test-only network and port.
ORCH_API_KEY=test-k1-6f4a2c9e8b1d7350a2c4e6f8b0d2a4c6
ORCH_MASTER_SECRET=test-master-1a3c5e7092b4d6f8a0c2e4860b1d3f57
OWUI_BASE_URL=http://stub-owui-test:8099
OWUI_ADMIN_TOKEN=stub-admin-token

ORCH_PORT=8081
ORCH_BIND=127.0.0.1
ORCH_TAG=dev
RUNNERS_NETWORK=owui-runners-test
RUNNER_IMAGE=owui-agent-runner:dev
# `owui` is external (ADR-0006: orchestrator joins OWUI's own network by
# name). This box does not run real OWUI, so the suite owns a throwaway
# stand-in network under this name (created/removed by conftest.py) instead
# of the operator's real `open-webui_default`.
OWUI_NETWORK=owui-runner-test-owui

# Small enough that several runners fit on a loaded dev box.
RUNNER_CPUS=0.5
RUNNER_MEMORY=320m
RUNNER_PIDS=256
MAX_CONTAINERS=3
MEMORY_RESERVE=128m
ADMIN_RUNNER_MEMORY=384m
ADMIN_RUNNER_CPUS=
ADMIN_RUNNER_DISK_SOFT=

# Short windows so idle/teardown/grace behaviour is testable in seconds.
IDLE_TIMEOUT=60s
DISK_POLL_INTERVAL=15
ROLE_CACHE_TTL=5
ROLE_CACHE_GRACE=30
OWUI_API_TIMEOUT=3

RUNNER_SECURITY_OPT=no-new-privileges,apparmor=unconfined
RUNNER_CAP_ADD=CHOWN,DAC_OVERRIDE,FOWNER,SETUID,SETGID

RUNNER_DISK_SOFT=5g
RUNNER_DISK_HARD=6g
WORKSPACE_TOTAL_CEILING=60g

PROXY_DENY_PREFIXES=/proxy,/ports,/api/terminals
OPEN_TERMINAL_MAX_SESSIONS=8
OPEN_TERMINAL_EXECUTE_TIMEOUT=120
OPEN_TERMINAL_SESSION_CWD_TTL=604800
RUNNER_VERSION=1
DOCKER_API_VERSION=v1.44
LOG_LEVEL=INFO
PIP_INDEX_URL=http://devguard-test:3141/root/pypi/+simple/
IDLE_SWEEP_INTERVAL=5
MEMORY_GATE=off
RUNNER_MEMORY_BUDGET=
FILES_SERVE_CSP=sandbox

VOLUME_RETENTION_DAYS=365
RETENTION_SWEEP_INTERVAL=3600

# v2 (ADR-0012, tickets 03-07): one test-only profile mapped to a group
# ("ops") that ONLY a uid containing "opsgroup" ever carries
# (tests/stub_owui.py groups_for) -- every other test's users keep resolving
# to "devs" or no group, neither of which GROUP_MAP maps, so this is additive
# and does not perturb ticket 01's no-op guard or any pre-existing test.
POLICY_HEAVY_CPUS=1
POLICY_HEAVY_MEMORY=200m
POLICY_HEAVY_EXEC_TIMEOUT=45s
# ticket 07: much shorter than the global IDLE_TIMEOUT=60s below, so a test
# can prove per-profile reclamation within one settle window instead of
# waiting out the full global timeout twice.
POLICY_HEAVY_IDLE_TIMEOUT=15s
# ticket 06: any non-"BLOCKED" value makes runner/shims/sandbox-shim.sh
# attempt a real (still always-failing) call instead of refusing instantly --
# "RELAXED" is arbitrary, chosen only to be obviously not "BLOCKED".
POLICY_HEAVY_EGRESS=RELAXED
# ticket 08: "ghost-team" is deliberately absent from stub_owui.py's roster
# (/api/v1/groups/) AND from every uid's own membership -- no user ever
# resolves through it, it exists purely so /_orch/status has something to
# report in unknown_mapped_groups.
GROUP_MAP=ops:heavy,ghost-team:heavy

# docker compose interpolates every service's environment block up front,
# even ones gated behind a profile that isn't selected, so a `:?required`
# var with no default breaks plain `up -d` unless it's here too.
DEVGUARD_DB_PASSWORD=test-devguard-db-9f1c3a5e7d2b4680

# Self-referential (docker-compose.yml orchestrator service, env_file:):
# tells compose to ALSO bulk-load this same file's vars straight into the
# orchestrator container, not just use it for ${VAR} substitution -- the
# only way an open-ended POLICY_<NAME>_* family reaches the container
# without a docker-compose.yml edit per profile. Path is relative to the
# compose project root (conftest.py always invokes `docker compose` with
# cwd=ROOT), not to this file's own directory.
ENV_FILE_NAME=tests/env.test
