# Ticket 10 REHEARSAL env — throwaway, never the live host.
#
# Modeled on .env.example, with all four secrets replaced by fake
# rehearsal-only values and OWUI_BASE_URL pointed at a throwaway stub
# container instead of the live box (192.168.138.101), which this rehearsal
# never touches. Always invoke `docker compose` with
# `--env-file .scratch/owui-runner-rebase-v2/rehearsal.env` explicitly for
# every command in this rehearsal -- never let it fall back to the real
# repo-root `.env`.
#
# ENV_FILE_NAME is self-referential (docker-compose.yml's `env_file:`,
# ticket 05): tells compose to bulk-load THIS SAME file's vars into the
# orchestrator container, not just use it for ${VAR} substitution -- the
# only way POLICY_<NAME>_* reaches the container without a docker-compose.yml
# edit per profile. Path is relative to the compose project root (repo
# root), matching how this command is invoked (cwd = repo root).
ENV_FILE_NAME=.scratch/owui-runner-rebase-v2/rehearsal.env

ORCH_API_KEY=rehearsal-k1-3f7a9c2e5b8d1046a2c4e6f8b0d2a4c6
ORCH_MASTER_SECRET=rehearsal-master-9a1c3e5709b2d4f6a8c0e2860b1d3f57
OWUI_BASE_URL=http://stub-owui-rehearsal:8099
OWUI_ADMIN_TOKEN=rehearsal-stub-admin-token

ORCH_PORT=8082
ORCH_BIND=127.0.0.1
ORCH_TAG=dev
RUNNERS_NETWORK=owui-runners-rehearsal
RUNNER_IMAGE=owui-agent-runner:dev
# Throwaway stand-in for OWUI's own network (ADR-0006) -- created and
# removed by this rehearsal, never the real open-webui_default.
OWUI_NETWORK=owui-rehearsal-owui

# Same global baseline as the README's worked example, so the rehearsal's
# boot-log table matches what README shows verbatim.
RUNNER_CPUS=1.5
RUNNER_MEMORY=768m
RUNNER_PIDS=256
MAX_CONTAINERS=3
MEMORY_RESERVE=128m
ADMIN_RUNNER_MEMORY=
ADMIN_RUNNER_CPUS=
ADMIN_RUNNER_DISK_SOFT=

# Short windows so idle/adoption behaviour is observable in seconds, not
# the real fleet's 30m.
IDLE_TIMEOUT=90s
DISK_POLL_INTERVAL=15
ROLE_CACHE_TTL=5
ROLE_CACHE_GRACE=30
OWUI_API_TIMEOUT=3
IDLE_SWEEP_INTERVAL=5

RUNNER_SECURITY_OPT=no-new-privileges,apparmor=unconfined
RUNNER_CAP_ADD=CHOWN,DAC_OVERRIDE,FOWNER,SETUID,SETGID

RUNNER_DISK_SOFT=5g
RUNNER_DISK_HARD=6g
WORKSPACE_TOTAL_CEILING=60g

PROXY_DENY_PREFIXES=/proxy,/ports,/api/terminals
OPEN_TERMINAL_MAX_SESSIONS=8
OPEN_TERMINAL_EXECUTE_TIMEOUT=120
OPEN_TERMINAL_SESSION_CWD_TTL=604800
RUNNER_VERSION=1
DOCKER_API_VERSION=v1.44
LOG_LEVEL=INFO
MEMORY_GATE=off
RUNNER_MEMORY_BUDGET=
FILES_SERVE_CSP=sandbox

VOLUME_RETENTION_DAYS=0
RETENTION_SWEEP_INTERVAL=3600

# docker compose interpolates every service's environment block up front,
# even ones gated behind a profile that isn't selected (DevGuard is not
# used in this rehearsal), so a `:?required` var with no default breaks
# plain `up -d` unless it's here too.
DEVGUARD_DB_PASSWORD=rehearsal-devguard-db-1f3a5c7e9d2b4680

# --- The two-profile rehearsal itself (mirrors README's worked example) ----
# "eval" is intentionally SHORTER-idle and RELAXED-egress relative to the
# default, and a distinct memory/cpu shape, so every checklist item (two
# differing container configs, differing egress stance, shorter-idle
# reclamation) is visible from ONE profile declaration.
POLICY_EVAL_CPUS=1
POLICY_EVAL_MEMORY=384m
POLICY_EVAL_IDLE_TIMEOUT=20s
POLICY_EVAL_EXEC_TIMEOUT=90s
POLICY_EVAL_EGRESS=RELAXED
# "ops" is tests/stub_owui.py's own sample group (any uid containing
# "opsgroup" carries it) -- reused here rather than inventing a new stub
# group, since this ticket is evidence, not code. "ghost-team" is
# deliberately never a real stub group, to rehearse the unknown-mapped-
# group boot/status warning on the same build.
GROUP_MAP=ops:eval,ghost-team:eval
